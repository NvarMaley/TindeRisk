  "blocks": {
    "A": {
      "name": "financial capacity and circumstances",
      "target_count": 10,
      "questions": [
        {
          "id": "A01",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "How long can most of this money stay invested?",
          "options": {
            "lt_2y": "Under 2 years",
            "2_to_lt_5y": "2 to under 5 years",
            "5_to_lt_10y": "5 to under 10 years",
            "ge_10y": "10 years or more",
            "unsure": "I am not sure"
          },
          "params": {
            "fixed_question": "F01"
          },
          "condition": null
        },
        {
          "id": "A02",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "How much will you need to take out in the next two years?",
          "options": {
            "none": "None",
            "gt_0_to_lt_25pct": "Some, under a quarter",
            "25_to_lt_50pct": "A quarter to under half",
            "ge_50pct": "Half or more",
            "unsure": "I am not sure"
          },
          "params": {
            "fixed_question": "F02"
          },
          "condition": null
        },
        {
          "id": "A03",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "If your income stopped, how long could your separate savings cover essentials?",
          "options": {
            "lt_1m": "Under 1 month",
            "1_to_lt_3m": "1 to under 3 months",
            "3_to_lt_6m": "3 to under 6 months",
            "ge_6m": "6 months or more",
            "unsure": "I am not sure"
          },
          "params": {
            "fixed_question": "F03"
          },
          "condition": null
        },
        {
          "id": "A04",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "After using separate savings, what investment loss would first make a planned payment hard to cover?",
          "options": {
            "lt_5pct": "Under 5%",
            "5_to_lt_10pct": "5% to under 10%",
            "10_to_lt_20pct": "10% to under 20%",
            "ge_20pct": "20% or more",
            "no_payment": "No payment depends on this money",
            "unsure": "I am not sure"
          },
          "params": {
            "fixed_question": "F04"
          },
          "condition": null
        },
        {
          "id": "A05",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "How much of your accessible savings are you putting into this investment?",
          "options": {
            "lt_25pct": "Under a quarter",
            "25_to_lt_50pct": "A quarter to under half",
            "ge_50pct": "Half or more",
            "unsure": "I am not sure"
          },
          "params": {},
          "condition": null
        },
        {
          "id": "A06",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
          "texte": "How predictable is your regular income?",
          "options": {
            "steady": "About the same most months",
            "varies": "Varies from month to month",
            "none": "I have no regular income",
            "unsure": "I am not sure"
          },
          "params": {},
          "condition": null
        },
        {
          "id": "A07",
          "bloc": "A",
          "type": "single",
          "dimension": "capacity",
