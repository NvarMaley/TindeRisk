        {
          "id": "A08",
          "bloc": "A",
          "type": "single",
          "dimension": "objectives",
          "texte": "What do you mainly want this investment to do?",
          "options": {
            "preservation": "Preserve my money",
            "income": "Provide regular income",
            "growth": "Grow over time",
            "planned_expense": "Pay for something specific",
            "other": "Something else",
            "unsure": "I am not sure"
          },
          "params": {},
          "condition": null
        },
        {
          "id": "A09",
          "bloc": "A",
          "type": "single",
          "dimension": "knowledge",
          "texte": "Have you ever held funds, ETFs, stocks or bonds?",
